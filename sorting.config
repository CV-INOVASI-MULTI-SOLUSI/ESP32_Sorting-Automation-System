# ============================================================
#  KONFIGURASI PRODUKSI -- sorting-automation.py (dulu orchestrator.config)
#
#  File ini HARUS berada di folder yang sama dengan sorting-automation.py & applib.py.
#  Pengaturan LAYAR (pin LCD, rotasi, warna) ada di file terpisah: display.config.
#  Edit dengan editor teks biasa, mis.:  nano sorting.config
#  lalu jalankan ulang orchestrator -- programnya tidak perlu disentuh.
#
#  Format:  nama = nilai      (teks setelah # diabaikan)
#  Nilai yang salah ketik membuat orchestrator berhenti SAAT MULAI dengan pesan yang
#  menyebut nama dan bagiannya -- tidak pernah di tengah produksi.
# ============================================================

[port]
rs485_port     = /dev/ttyS3    # UART3 -- pin fisik 8 (TX) / 10 (RX)
rs485_baud     = 19200         # HARUS sama dengan Rs485Cfg::BAUD di keempat firmware ESP32
huskylens_port = /dev/ttyUSB0  # adapter USB-TTL (UART1 /dev/ttyS1 = pin 38/40, kini dipakai LED)
huskylens_baud = 9600          # HARUS sama dengan Protocol Type di menu HuskyLens (115200 lebih cepat)

[produksi]
batch_size = 8                # objek PASS per package (bisa ditimpa: --batch N)
# Berhenti RAPI setelah sekian siklus (1 siklus = 1 package disimpan ke 1 rak).

# 0 = sampai semua rak yang kosong saat mulai terisi. Bisa ditimpa: --siklus N
jumlah_siklus = 0

# 1 = Stocker mulai menyimpan begitu Picker selesai menaruh (lengan masih menuju READY).
# 0 = Stocker baru mulai setelah lengan kembali di READY -- Picker & Stocker tidak
#     pernah bergerak bersamaan. Pakai ini kalau ada node yang restart / tidak menjawab
#     saat keduanya jalan bersamaan (tanda catu daya tidak kuat).
stocker_paralel = 1

# Jeda umpan hopper Sorter selama package diganti (conveyor & palang Sorter TETAP jalan):
# 0 = hopper tidak pernah dijeda
# 1 = dijeda saat REQUEST_REFILL dikirim ke Dispenser
# 2 = dijeda begitu hitungan batch tercapai (sebelum delay_batch_s) -- paling sedikit objek
#     menyusul ke package yang sedang diganti
# Hopper dilanjutkan otomatis begitu package kosong berikutnya siap di TENGAH Dispenser.
# Butuh firmware Sorter >= 2026-10-05.
jeda_hopper = 1
# Kapan hopper yang dijeda dilanjutkan:
# 1 = begitu lengan Picker kembali di HOME setelah menaruh (tidak menunggu READY)
# 0 = begitu package kosong berikutnya siap di TENGAH Dispenser (paling aman: objek baru
#     pasti punya tempat jatuh)
lanjut_hopper = 1

[rak]
# Urutan rak yang dipakai, dipisah koma. Rak yang tidak ditulis tidak pernah dipakai.
urutan_rak = 1, 2, 3, 4
# 0 = berurutan sesuai urutan_rak (1 - 2 - 3 - 4)
# 1 = acak di antara rak yang masih kosong
rak_random = 0
# 0 = Stocker belum punya sensor rak: rak terisi hanya dari catatan program (rak_terisi.txt).
#     Setelah rak dikosongkan fisik, jalankan:  python3 sorting-automation.py --kosongkan-rak
# 1 = sensor rak terpasang: rak yang sensornya bilang terisi juga dilewati.
pakai_sensor_rak = 0

[delay]
# Semua dalam detik -- jeda sengaja sebelum sebuah langkah dimulai.
# Batch: setelah hitungan PASS Sorter mencapai batch_size, sebelum package dibawa pergi.
# Sensor PASS berjarak dari ujung conveyor -- objek terakhir masih berjalan ke package.
delay_batch_s     = 2.0
# Picker: setelah package penuh sampai UJUNG (PROX_1), sebelum MOVE_PACKAGE dikirim.
delay_picker_s    = 0.0
# Dispenser: setelah PROX_1 kosong (package terangkat sendok), sebelum ACK_PACKAGE_TAKEN.
# Conveyor Dispenser langsung jalan setelah ACK -- pastikan sendok sudah naik dari belt.
delay_dispenser_s = 1.0
# Stocker: setelah Picker selesai menaruh package dan kembali ke HOME (sendok sudah keluar
# dari bawah package), sebelum Stocker mulai menyimpan ke rak.
delay_stocker_s   = 1.0

[pin]
# Nomor wPi (kolom "wPi" di `gpio readall`), BUKAN nomor pin fisik.
# Kosongkan (atau tulis none) = tidak dipakai. Cocokkan dulu dengan `gpio readall`.
# JANGAN memakai nomor yang jatuh di pin fisik 8/10 (RS485), atau 38/40 kalau HuskyLens
# memakai UART1 (sekarang HuskyLens lewat USB, jadi 38/40 dipakai LED): pin itu berubah
# jadi GPIO biasa dan komunikasinya mati tanpa pesan error. Pin 19/21/23/24 = SPI layar LCD.
led_red   = none               # kedip saat objek INVALID -- RED (pin 37) dipakai LED alarm
led_blue  = 27                 # kedip saat objek VALID  -- pin fisik 40 (board: GREEN)
buzzer    = 20                 # pin fisik 31 (board: BUZ)
led_opr   = 26                 # pin fisik 38 (board: BLUE, GPIO20) -- nyala = produksi jalan, kedip = startup
led_alarm = 25                 # pin fisik 37 (board: RED, GPIO26) -- nyala = produksi DITAHAN

[huskylens]
# 1 = pakai kamera HuskyLens untuk klasifikasi VALID/INVALID (palang mendorong reject)
# 0 = tanpa kamera: semua objek dianggap PASS, palang tidak bekerja, port HuskyLens tidak
#     dibuka sama sekali. Sama dengan menjalankan --tanpa-kamera.
pakai_kamera      = 1
jumlah_sampel     = 3
interval_sampel_s = 0.05
batas_ambil_s     = 0.7
id_kosong         = 1
id_valid          = 3
id_invalid        = 2, 4, 5    # boleh lebih dari satu, pisahkan dengan koma
min_kosong_s      = 0.3        # bidang pandang harus kosong selama ini sebelum objek berikutnya

[pemantauan]
poll_s      = 0.5              # jeda pemantauan PASS_COUNT Sorter
keepalive_s = 5.0              # watchdog node 30 s -- jauh di bawahnya

[batas_waktu]
# Detik. Lewat dari ini produksi DITAHAN.
t_ack                 = 5.0
t_picker_home         = 30.0   # Picker menuju READY saat startup
t_stocker_homing      = 120.0
t_stocker_gerak       = 60.0
t_dispenser_siap_awal = 180.0  # urutan awal: servo1, servo2, lalu package jalan ke PROX_2
t_dispenser_siap      = 90.0
t_package_ujung       = 30.0   # firmware sendiri memberi 20 s
t_move_package        = 180.0
t_full_cycle          = 120.0
# Ack yang datang lebih cepat dari ini mustahil berarti gerakan selesai -- berarti DITOLAK.
min_durasi_move_package_s = 3.0
min_durasi_full_cycle_s   = 2.0
