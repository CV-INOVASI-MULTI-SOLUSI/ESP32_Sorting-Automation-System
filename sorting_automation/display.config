# ============================================================
#  KONFIGURASI LAYAR -- display.config (dipakai sorting-automation.py, mode panel)
#
#  LCD 3.2" ILI9341 (SPI) + touch XPT2046. Edit dengan:  nano display.config
#  Nilai yang salah ketik membuat program berhenti SAAT MULAI dengan pesan jelas.
#  Pin = nomor wPi; pin fisik di komentar mengikuti tabel wiringOP umum untuk board H3 --
#  COCOKKAN dengan `gpio readall` sebelum menyambung.
#
#  SAMBUNGAN (pin modul -> pin fisik Orange Pi, nama lama di board)
#    T_IRQ -> 33 (ARM)      T_OUT -> 21 (IN8)     T_DIN -> 19 (WRL)    T_CS -> 11 (D_OUT)
#    T_CLK -> 23 (IN6)      SDO   -> tidak disambung                    LED  -> 17 (3.3V)
#    SCK   -> 23 (IN6)      SDI   -> 19 (WRL)     D/C   -> 27 (D9)     RESET -> 13 (PST)
#    CS    -> 28 (D8)       GND   -> 6            VCC   -> 1 (3.3V)
#    T_DIN & SDI satu jalur (pin 19), T_CLK & SCK satu jalur (pin 23).
#    Pin 24 (CE0, IN5) TIDAK disambung, tapi dikuasai SPI -- jangan dipakai fungsi lain.
#  CS LCD sengaja lewat GPIO: kalau di CE0, tiap pembacaan touch ikut mengaktifkan LCD.
# ============================================================

[tampilan]
judul = SECURA                 # nama di header layar
font_tajam = 1                 # 1 = huruf tanpa antialias (tajam di layar 320x240), 0 = halus/antialias

[lcd]
lcd_spi_bus    = 0             # /dev/spidev0.0 -- butuh overlay spi-spidev di armbianEnv.txt
lcd_spi_device = 0
lcd_spi_hz     = 24000000      # turunkan ke 12000000 kalau gambar rusak (kabel panjang)
lcd_rotasi     = 1             # 1 = mendatar, 3 = mendatar terbalik (180 derajat)
lcd_bgr        = 1             # 1 = urutan warna BGR (umum di modul ILI9341); 0 kalau merah/biru tertukar
lcd_invert     = 0             # 1 kalau warna tampil terbalik (putih jadi hitam)
lcd_pin_dc     = 17            # D/C   -> pin fisik 27 (board: D9)
lcd_pin_cs     = 18            # CS    -> pin fisik 28 (board: D8)
lcd_pin_rst    = 7             # RESET -> pin fisik 13 (board: PST); none = RESET ke 3.3V
lcd_pin_led    = none          # LED   -> 3.3V (none); isi nomor wPi kalau lewat GPIO
touch_cs       = 5             # T_CS  -> pin fisik 11 (board: D_OUT)
touch_irq      = none          # none = sentuhan dari tekanan panel (SPI). T_IRQ di pin fisik 33 (board: ARM)
                               # TIDAK sampai ke Orange Pi (2026-10-07: `gpio read 22` tetap 1 saat
                               # ditekan). Touch dulu bekerja hanya karena pullUpDnControl() Python yang
                               # rusak membuat pin itu terbaca 0. Pakai IRQ lagi = pindah ke pin yang
                               # terbukti 1/0 saat dilepas/ditekan, mis. 23 (pin fisik 35).
# Mode bit-bang (touch di pin GPIO sendiri, tidak berbagi SPI): isi tiga ini.
# none = mode SPI berbagi (T_CLK/T_DIN/T_OUT ke SCK/SDI/MISO seperti di atas).
touch_clk      = none          # T_CLK
touch_din      = none          # T_DIN
touch_out      = none          # T_OUT

[warna]
# Tema warna, format RRGGBB (heksadesimal, TANPA tanda #). Hapus baris = warna bawaan.
latar     = 0B131F            # latar layar
kartu     = 162234            # kartu / panel
kartu2    = 202F46            # tombol netral
biru      = 1E78E6            # tab aktif, tombol utama
hijau     = 22AA50            # RUNNING, OK, START
merah     = DC3C3C            # STOP, alarm, reject
kuning    = F0BE28            # peringatan, nilai setting
oranye    = EB7D1E
abu       = 8C9CB2            # teks keterangan