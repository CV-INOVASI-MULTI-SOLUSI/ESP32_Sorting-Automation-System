# ============================================================
#  WAKTU SIMULASI 4 NODE -- dibaca simulasi-node.py (juga mode --simulasi)
#
#  Nilai bawaan = nilai DEFAULT di firmware (struct cfg tiap node). Yang bertanda
#  "asumsi" tidak ada di firmware (jarak fisik mesin / hasil kalibrasi) -- ganti dengan
#  hasil ukur di mesin Anda supaya durasinya sama dengan aslinya.
#
#  Durasi dihitung seperti firmware menghitungnya:
#    servo / hopper  = (selisih us / step_us) x step_interval_ms
#    lengan Picker   = (selisih us / traj_step_us) x traj_step_interval_ms
#    stepper Stocker = langkah x step_interval_us
#    objek conveyor  = jarak mm / (mm_per_s_pwm_max x pwm / 255)
#  Command SET_* dari master (kecepatan, step, interval) ikut mengubah durasi saat simulasi.
# ============================================================

[umum]
cepat              = 1.0     # 2 = semua 2x lebih cepat dari waktu nyata
watchdog_s         = 30      # COMM_TIMEOUT_MS firmware (node RUNNING tanpa request -> FAULT 1)

[sorter]
conveyor_pwm           = 180    # cfg.conveyorSpeed
mm_per_s_pwm_max       = 300    # cfg.mmPerSecAtMaxPwm (kecepatan conveyor di PWM 255)
jarak_scan_palang_mm   = 150    # cfg.distMm -- jarak titik scan kamera ke palang (TOF)
jarak_hopper_scan_mm   = 250    # asumsi -- objek jatuh dari hopper sampai depan kamera
jarak_palang_pass_mm   = 200    # asumsi -- palang sampai sensor PASS (PROX_2)
jarak_uji_kecepatan_mm = 200    # cfg.speedTestDistMm (PROX_1 -> PROX_2)
palang_push_ms         = 300    # cfg.palangPushMs
palang_retract_ms      = 300    # cfg.palangRetractMs
hopper_start_us        = 1000   # cfg.hopperStartUs
hopper_push_us         = 2000   # cfg.hopperPushUs
hopper_step_us         = 20     # cfg.hopperStepUs
hopper_step_interval_ms = 20    # cfg.hopperStepIntervalMs
hopper_hold_ms         = 300    # cfg.hopperPushHoldMs
hopper_jeda_siklus_ms  = 1000   # cfg.hopperCycleGapMs
peluang_objek          = 1.0    # asumsi -- 1.0 = setiap siklus hopper menjatuhkan 1 objek

[picker]
traj_step_us           = 20     # trajStepUs
traj_step_interval_ms  = 20     # trajStepIntervalMs
jarak_pose_us          = 800    # asumsi -- selisih joint terbesar antar pose (dari kalibrasi pose)
adegan_per_gerakan     = 3      # asumsi -- adegan ON per gerakan
jarak_adegan_us        = 300    # asumsi -- gerak satu joint per adegan
pick_offset_us         = 600    # PICK_OFFSET terbesar (default {0,0,-200,0,0,600})
place_offset_us        = 600    # asumsi -- PLACE_OFFSET terbesar

[dispenser]
servo_start_us         = 1000   # cfg.servo1StartUs / servo2StartUs
servo_end_us           = 2000   # cfg.servo1EndUs / servo2EndUs
servo_step_us          = 20     # cfg.servo1StepUs
servo_step_interval_ms = 20     # cfg.servo1StepIntervalMs
servo_hold_ms          = 500    # cfg.servo1HoldMs
conveyor_ke_tengah_s   = 2.0    # asumsi -- package kosong dari tumpukan sampai sensor TENGAH
conveyor_ke_ujung_s    = 3.0    # asumsi -- package dari TENGAH sampai sensor UJUNG
batas_box_tiba_s       = 8.0    # firmware: > 8000 ms -> FAULT BOX_NOT_ARRIVED
stok_package           = 50     # asumsi -- jumlah package kosong di tumpukan

[stocker]
step_interval_us        = 600   # stepIntervalUs
homing_step_interval_us = 150   # homingStepIntervalUs
langkah_homing_per_axis = 6000  # asumsi -- jarak terjauh ke limit switch
langkah_antar_rak       = 3000  # asumsi -- jarak X/Z antar rak
langkah_ready_ke_rak1   = 2000  # asumsi -- READY (loadPos) ke Rak 1
push_extend_steps       = 1000  # pushExtendSteps
